{
  "name": "cdk-starter",
  "version": "1.0.0",
  "main": "dist/lib/index.js",
  "bin": {
    "cdk-starter": "dist/bin/cdk-starter.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "watch": "tsc -w",
    "cdk": "cdk",
