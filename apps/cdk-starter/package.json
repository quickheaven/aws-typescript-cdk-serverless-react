    "@repo/typescript-config": "workspace:*",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "aws-cdk": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:"
  }
}
