### Variable definitions
@url = https://shjfowznkd.execute-api.us-east-1.amazonaws.com/prod
@contentType = application/json
@token = ><YOUR_ID_TOKEN>

### Get all spaces
# @name getAllSpaces
GET {{url}}/spaces
Authorization: {{token}}


### Create a new space
# @name createSpace
POST {{url}}/spaces
Authorization: {{token}}
content-type: {{contentType}}

{
    "name": "Paris Space",
    "location": "Paris"
}


### Get a space by ID
# @name getSpaceById
GET {{url}}/spaces?id={{createSpace.response.body.id}}
Authorization: {{token}}

### Update a space by ID
# @name updateSpace
PUT {{url}}/spaces?id={{createSpace.response.body.id}}
content-type: {{contentType}}
Authorization: {{token}}

{
    "location": "Paris2"
}

### Delete a space by ID
# @name deleteSpace
DELETE {{url}}/spaces?id={{createSpace.response.body.id}}
Authorization: {{token}}
